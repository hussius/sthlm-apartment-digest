# --- Database (Neon Postgres) ---
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Must be a verified sender/domain in Resend (e.g. digest@yourdomain.se)
DIGEST_FROM=Bostadsdigest <digest@example.com>
DIGEST_TO=you@example.com

# --- Behaviour ---
# When set, do a real fetch + filter but DON'T email or write to DB.
# Writes the rendered digest to scratch/digest.html and prints matches.
DRY_RUN=

# Timezone used to decide the "run date" label in the email.
TZ=Europe/Stockholm

# --- Tunable criteria (all optional; defaults in src/config.ts) ---
# CENTRAL_MAX_RENT=15000
# CENTRAL_MIN_ROOMS=3
# CENTRAL_MIN_SQM=60
# TEMP_BONUS_MAX_RENT=10000
# YOUTH_AGE=19
# YOUTH_EXACT=1   # show the "endast YOUTH_AGE år" section (hidden by default)
# YOUTH_RANGE=1   # show the broader youth age-range section (hidden by default)
